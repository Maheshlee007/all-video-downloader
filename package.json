{
  "name": "clipnest-universal",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-content.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "check": "npm test && npm run build",
    "package": "npm run build && node scripts/package.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "dashjs": "^5.0.3",
    "fast-xml-parser": "^5.3.0",
    "hls.js": "^1.6.13",
    "lucide-react": "^0.468.0",
    "mux.js": "^7.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
